# HHBA 环境变量模板 —— 只保留变量名与安全占位符
# 真实值写入 .env（已加入 .gitignore，绝不提交）

# --- PostgreSQL（本地 Docker） ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=hhba_dev
POSTGRES_USER=hhba
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://hhba:CHANGE_ME@127.0.0.1:5432/hhba_dev

# --- API 服务 ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Meilisearch（可选，V0.2 阶段） ---
MEILI_HOST=127.0.0.1
MEILI_PORT=7700
MEILI_MASTER_KEY=CHANGE_ME

# --- 模型 API（预留，不锁定供应商） ---
MODEL_API_BASE=https://api.example.com/v1
MODEL_API_KEY=CHANGE_ME
MODEL_NAME=
