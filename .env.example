# Copy to .env for local-only values. Never commit .env.
HHBA_ENV=development
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
POSTGRES_DB=hhba_dev
POSTGRES_USER=hhba_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql://hhba_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/hhba_dev
AI_MODEL_PROVIDER=UNCONFIGURED
AI_MODEL_API_KEY=REPLACE_WITH_LOCAL_SECRET
