# HHBA 生产环境变量模板 —— 复制为 .env.production 后填真实值。
# 纪律：.env.production 禁止提交 Git；真实密钥只存在于 ECS 服务器文件（chmod 600）
# 或云端密钥管理中。本模板只有变量名与占位符，没有任何真实值。

# ===== 站点与代理 =====
HHBA_DOMAIN=www.example.com            # 正式域名（Caddy 证书主体）
APP_ORIGIN=https://www.example.com     # 应用可信 Origin，必须与浏览器实际 Origin 完全一致
ACME_EMAIL=ops@example.com             # Let's Encrypt 证书通知邮箱
TRUSTED_PROXY=caddy                    # 可信反向代理标识；服务端只信任来自该代理的转发头

# ===== 管理后台（沿用 admin-console.ts 现有机制）=====
HHBA_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_20_CHARS   # >=20 位；HMAC Cookie 签名亦派生自它

# ===== 数据库（Phase 2 账户系统）=====
POSTGRES_DB=hhba
POSTGRES_USER=hhba
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
DATABASE_URL=postgres://hhba:CHANGE_ME_STRONG_RANDOM@postgres:5432/hhba

# ===== 短信验证码（Phase 2）=====
SMS_CODE_PEPPER=CHANGE_ME_RANDOM_32_PLUS_CHARS    # 验证码 HMAC 哈希的服务端密钥，泄漏=可离线爆破 6 位码
SESSION_SECRET=CHANGE_ME_ANOTHER_RANDOM_32_PLUS   # 会话令牌哈希密钥，必须与 SMS_CODE_PEPPER 不同值
HHBA_SMS_PROVIDER=mock                 # 生产审核通过后改为 aliyun；mock 在 production 会被代码拒绝启动
HHBA_ALLOW_MOCK_SMS=0                  # 仅非 production 联调可设 1；生产必须为 0
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=                  # 阿里云短信已审核签名（控制台申请，见 RISKS_AND_MANUAL.md）
ALIYUN_SMS_TEMPLATE_CODE=              # 阿里云短信已审核模板 CODE，模板变量约定为 ${code}
ALIYUN_SMS_REGION=cn-hangzhou

# ===== 业务开关（默认值与 Railway 线上一致，灰度时逐项打开）=====
VITE_HHBA_VERIFIED_SNAPSHOT=1          # 前端构建参数（构建时注入）
VITE_HHBA_ACCOUNT_API_ENABLED=0        # 旧邮箱账户 API 开关：保持 0，新登录走 /api/v1 手机验证码
HHBA_AUTH_ENABLED=0                    # 新账户系统总开关；联调通过后置 1
HHBA_NATIVE_INDEX_READ=1               # 从 /sync-state/public-index 读岗位索引
HHBA_NATIVE_INDEX_PUBLISH=0            # 索引重建发布（ECS 定时任务验证后再开）
HHBA_JD_SYNC_ENABLED=0                 # 海外 JD 同步（依赖翻译服务，未就绪前关闭不影响原文展示）
HHBA_TRANSLATOR_URL=                   # 私有翻译服务地址；为空时 JD 中文翻译降级（审计已知项）
