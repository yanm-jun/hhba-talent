# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# JavaScript
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
worker-image-build*.log
apps/api/api-local.*.log
apps/web/web-local.*.log

# Python
.venv/
.tooling/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local data and generated files
data/
uploads/
apps/api/private_uploads/
# Defensive rule for an API accidentally started from the repository root.
# Uploaded resumes must never be tracked, even when their relative storage
# root resolves here rather than under apps/api.
private_uploads/
# Private enterprise-verification documents; test runs use a UUID-suffixed
# root and neither synthetic nor real credentials belong in version control.
private_verification_documents/
phase3a2-private-*/
work/
*.sqlite3
coverage/
# Local browser/automation evidence can contain synthetic profile content and
# is recorded in reports by path only; it must not enter source control.
tests/evidence/

# Editors / operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
