{
  "manifest_version": 3,
  "name": "汇方职场 HHBA 智能网申助手",
  "version": "0.5.0",
  "description": "汇方职场 HHBA 网申助手：低风险网申字段一键预填与撤销；用户授权后才使用 AI 字段分析，不自动提交或收费。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "汇方职场 HHBA 网申助手",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "optional_host_permissions": [
    "https://hhba.work/*"
  ]
}
