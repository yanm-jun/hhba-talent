{
  "manifest_version": 3,
  "name": "HHBA 智能网申助手",
  "version": "0.4.0",
  "description": "国内网申低风险字段一键预填、短期只读账户连接（需手动授权）、回读检查及撤销，不自动提交或收费。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "HHBA 网申助手",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "optional_host_permissions": [
    "https://hhba.work/*"
  ]
}
