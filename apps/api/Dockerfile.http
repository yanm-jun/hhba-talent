# Dedicated HTTP service for HHBA identity and employer workflows.
# No Docling worker, job spider, or public JD cache is co-located here.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv/hhba
RUN groupadd --gid 10001 hhba && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin hhba
RUN pip install --no-cache-dir \
  'fastapi>=0.115,<1' 'uvicorn>=0.30,<1' 'sqlalchemy>=2.0,<2.1' \
  'alembic>=1.14,<2' 'psycopg[binary]>=3.2,<4' \
  'pwdlib[argon2]>=0.2,<1' 'email-validator==2.3.0' \
  'python-multipart>=0.0.20,<1'
COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini
RUN python -m compileall -q app migrations
USER 10001:10001
EXPOSE 8080
# Production DATABASE_URL, exact HTTPS origin and two private data roots are
# checked at module import; fail closed if not configured.
CMD ["python","-m","uvicorn","app.main:app","--host","0.0.0.0","--port","8080","--proxy-headers","--forwarded-allow-ips","127.0.0.1"]
